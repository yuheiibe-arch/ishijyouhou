/**
 * 契約テキストの期中変更ブロックすべてに、祝日・年末年始フッターを適切に補正する関数（V2）
 */
function autoFixHolidayFooter_v2(text) {
  if (!text) return "";
  
  // 1. 「20xx/xx/xx～」という期間の開始位置でテキストをブロックに分割
  const blocks = text.split(/(?=\d{4}[\/\-]\d{1,2}[\/\-]\d{1,2}～)/);
  
  // 2. テキスト全体からすべてのフッターを抽出
  const allFooters = text.match(/（祝日：.+?[／/]\s*年末年始：.+?）/g);
  if (!allFooters || allFooters.length === 0) return text; // フッターが1つも無ければ何もしない
  
  // 3. 最後に登場するフッターを「最新のルール」として保持
  const latestFooter = allFooters[allFooters.length - 1];
  
  const fixedBlocks = blocks.map(block => {
    let b = block.trim();
    if (!b) return "";
    
    // このブロック自身が過去のフッターを持っているか確認
    const ownFooterMatch = b.match(/（祝日：.+?[／/]\s*年末年始：.+?）/);
    const ownFooter = ownFooterMatch ? ownFooterMatch[0] : null;
    
    // 一旦ブロック内のフッターを綺麗に消去する
    b = b.replace(/[\r\n]*（祝日：.+?[／/]\s*年末年始：.+?）/g, "").trim();
    
    // 自身がフッターを持っていればそれを、持っていなければ「最新のルール」を適用
    const footerToApply = ownFooter ? ownFooter : latestFooter;
    
    return b + "\n" + footerToApply;
  });
  
  // ブロック同士を空行で繋ぎ直して返す
  return fixedBlocks.filter(Boolean).join("\n\n");
}